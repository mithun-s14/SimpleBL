GROQ_API_KEY=gsk_...
PORT=3001

# --- Keenan Wiki ---------------------------------------------------------
# A UC... channel ID, or an @handle when using the youtubei.js fallback.
KEENAN_CHANNEL_ID=
# Optional. Without it, video discovery falls back to youtubei.js.
YOUTUBE_API_KEY=
# The feature ships dark: the API returns 503 until this is true.
KEENAN_WIKI_ENABLED=false
# Changing this invalidates every stored vector and forces a re-embed.
KEENAN_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
KEENAN_ANSWER_MODEL=openai/gpt-oss-120b
# Interpreter with backend/ingest/requirements.txt installed (ingest only).
KEENAN_PYTHON=python3
